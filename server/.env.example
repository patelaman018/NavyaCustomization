# Copy this file to .env and fill in real values. Do NOT commit .env.

# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL (Neon or any Postgres). For Neon, copy the connection string from
# the dashboard; it looks like:
#   postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=true

# Email notifications (optional — left as placeholders, notifications are skipped)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=navyacustomization@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=navyacustomization@gmail.com
EMAIL_TO=navyacustomization@gmail.com

# Admin dashboard passcode (sent as x-admin-key header).
# Generate a strong one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_KEY=replace-with-a-long-random-string
